/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/announcements.json
  Cache-Control: public, max-age=600, must-revalidate

/roadmap.json
  Cache-Control: public, max-age=600, must-revalidate

/go/instagram-fr-202608-r3/
  Cache-Control: no-store
  Content-Language: fr
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; script-src 'none'; connect-src 'none'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# Prevent versioned preview URLs and the disabled workers.dev alias from being
# indexed. The canonical inset.page host is unaffected.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow
