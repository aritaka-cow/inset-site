{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "error",
    "close-order": "error",
    "doctype-style": "error",
    "element-permitted-content": "error",
    "heading-level": "off",
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h37": "error",
    "wcag/h63": "error"
  }
}
