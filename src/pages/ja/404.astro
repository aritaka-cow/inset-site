---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor } from "@/data/site";
---
<BaseLayout locale="ja" title="ページが見つかりません — Inset" description="指定されたInsetのページが見つかりませんでした。" currentPath="/ja/404/" counterpartPath="/404.html" noindex>
  <section class="not-found"><div><h1>404</h1><p>ページが見つかりませんでした。Insetのホームまたは更新情報へ戻れます。</p><a class="text-link" href={pathFor("home", "ja")}>ホームへ戻る</a></div></section>
</BaseLayout>
