---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor } from "@/data/site";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const homePath = `${base}${pathFor("home", "ja").replace(/^\//, "")}`;
---
<BaseLayout locale="ja" title="ページが見つかりません — Inset" description="指定されたInsetのページが見つかりませんでした。" currentPath="/ja/404/" counterpartPath="/404.html" noindex>
  <section class="not-found"><div><h1>404</h1><p>ページが見つかりませんでした。Insetのホームまたは更新情報へ戻れます。</p><a class="text-link" href={homePath}>ホームへ戻る</a></div></section>
</BaseLayout>
