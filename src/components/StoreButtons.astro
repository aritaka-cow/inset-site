---
import { appStoreClickPath, appStoreUrls, storeCopy, type AppStorePlacement, type Locale } from "@/data/site";

interface Props {
  locale: Locale;
  placement: AppStorePlacement;
  compact?: boolean;
}

const { locale, placement, compact = false } = Astro.props;
const copy = storeCopy[locale];
const base = import.meta.env.BASE_URL;
const badgePath = `${base}store-badges/app-store-${locale}.svg`;
const badgeWidth = locale === "ja" ? 109 : 120;
const trackClick = import.meta.env.PUBLIC_SITE_ENV === "production" && base === "/";
const appStoreHref = trackClick ? appStoreClickPath(locale, placement) : appStoreUrls[locale];
---

<div class:list={["store-buttons", { "store-buttons--compact": compact }]}>
  <a class="store-badge store-badge--app-store" href={appStoreHref} rel="external nofollow" aria-label={copy.available} data-app-store-placement={placement}>
    <img src={badgePath} width={badgeWidth} height="40" alt="" />
  </a>
  <span class="store-coming-soon">
    <span>{copy.googlePlay}</span>
    <small>{copy.comingSoon}</small>
  </span>
</div>
