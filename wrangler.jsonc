{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inset-site",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "inset.page",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
